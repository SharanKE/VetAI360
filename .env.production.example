# =============================================================================
# VetAI 360 — Production environment template
# Copy to .env.prod and fill in your values before cloud/VPS deployment.
# =============================================================================

# --- MongoDB Atlas (required for production) ---
# Create a free M0 cluster at https://cloud.mongodb.com
# Connection string format:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vetai360?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://vetai360_user:CHANGE_ME@cluster0.xxxxx.mongodb.net/vetai360?retryWrites=true&w=majority
MONGO_DB_NAME=vetai360

# --- Security ---
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Backend ---
DB_TYPE=mongo
NODE_ENV=production
SEED_ON_START=true
ALLOW_RENDER_ORIGINS=true

# Comma-separated allowed frontend origins (your deployed URL + localhost for testing)
CLIENT_ORIGIN=https://vetai360-web.onrender.com,http://localhost:5173

# --- ML service (internal URL when using Docker Compose) ---
ML_SERVICE_URL=http://ml-service:8000

# --- Frontend build URLs (your public API hostname) ---
VITE_API_URL=https://vetai360-api.onrender.com/api
VITE_SOCKET_URL=https://vetai360-api.onrender.com

# --- Render-specific (set automatically by Render if using render.yaml) ---
# VITE_BACKEND_URL=https://vetai360-api.onrender.com
