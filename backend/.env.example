# Copy this file to .env before running the server

PORT=5000
JWT_SECRET=vetai360_super_secret_change_me
JWT_EXPIRES_IN=7d

# Database backend: sqlite (zero setup) or mongo (production / Docker)
DB_TYPE=sqlite

# SQLite — used when DB_TYPE=sqlite
DB_PATH=./data/vetai360.db

# MongoDB — used when DB_TYPE=mongo (local Docker or MongoDB Atlas in production)
# Atlas format: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/vetai360?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/vetai360
MONGO_DB_NAME=vetai360

# URL of the Python ML microservice (see /ml-service)
ML_SERVICE_URL=http://localhost:8000

# Optional AI Cloud Vision keys (falls back to local offline ML service if unset)
# Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Frontend origin(s) for CORS — comma-separated in production
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Cloud: allow any *.onrender.com origin (set true when deploying to Render)
ALLOW_RENDER_ORIGINS=false

# Cloud: seed demo accounts on container start (set true for first deploy)
SEED_ON_START=false

# How often (ms) the simulated IoT sensors emit a new reading per monitored animal
SENSOR_SIMULATION_INTERVAL_MS=8000
